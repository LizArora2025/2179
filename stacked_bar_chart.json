{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Provoked vs Unprovoked Incidents",

  "width": 500,
  "height": 400,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "calculate": "(datum['Provoked/unprovoked'] == null || datum['Provoked/unprovoked'] == '') ? 'unknown' : datum['Provoked/unprovoked']",
      "as": "IncidentType"
    }
  ],

  "mark": "bar",

  "encoding": {

    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State"
    },

    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Count of Records"
    },

    "color": {
      "field": "IncidentType",
      "type": "nominal",
      "title": "Provoked/unprovoked",
      "scale": {
        "domain": [
          "provoked",
          "unprovoked",
          "unknown"
        ],
        "range": [
          "#f58518",
          "#e45756",
          "#4c78a8"
        ]
      }
    },

    "tooltip": [
      {
        "field": "State",
        "type": "nominal"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Incidents"
      },
      {
        "field": "IncidentType",
        "type": "nominal",
        "title": "Type"
      }
    ]
  }
}
