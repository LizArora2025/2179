{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Fatal vs Injured Shark Incidents by Month",

  "width": 700,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "calculate": "datum['Incident.month']",
      "as": "Month"
    },
    {
      "calculate": "datum['Victim.injury']",
      "as": "Outcome"
    }
  ],

  "mark": "bar",

  "encoding": {
    "x": {
      "field": "Month",
      "type": "ordinal",
      "title": "Month"
    },

    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Incidents"
    },

    "color": {
      "field": "Outcome",
      "type": "nominal",
      "title": "Outcome",
      "scale": {
        "domain": ["fatal", "injured"],
        "range": ["#d62828", "#5b9bd5"]
      }
    },

    "tooltip": [
      {
        "field": "Month",
        "title": "Month"
      },
      {
        "field": "Outcome",
        "title": "Outcome"
      },
      {
        "aggregate": "count",
        "title": "Incidents"
      }
    ]
  }
}
