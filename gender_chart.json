{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Shark Incidents per 100,000 Population by State",

  "width": 600,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Incidents"
        },
        {
          "op": "max",
          "field": "Population_2025_000",
          "as": "Population"
        }
      ],
      "groupby": ["StateName"]
    },

    {
      "calculate": "(datum.Incidents / (datum.Population * 1000)) * 100000",
      "as": "IncidentsPer100k"
    }
  ],

  "mark": {
    "type": "bar",
    "color": "#5b9bd5"
  },

  "encoding": {

    "y": {
      "field": "StateName",
      "type": "nominal",
      "sort": "-x",
      "title": "State"
    },

    "x": {
      "field": "IncidentsPer100k",
      "type": "quantitative",
      "title": "Incidents per 100,000 Population"
    },

    "tooltip": [
      {
        "field": "StateName",
        "title": "State"
      },
      {
        "field": "Incidents",
        "title": "Total Incidents"
      },
      {
        "field": "Population",
        "title": "Population (000s)"
      },
      {
        "field": "IncidentsPer100k",
        "format": ".2f",
        "title": "Incidents per 100k"
      }
    ]
  }
}
