{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Shark Incidents per Million Residents by State",

  "width": 650,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents_Merged.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Incidents"
        },
        {
          "op": "max",
          "field": "Population_2025_000",
          "as": "Population"
        }
      ],
      "groupby": ["State"]
    },

    {
      "calculate": "(datum.Incidents / datum.Population) * 1000000",
      "as": "IncidentsPerMillion"
    }
  ],

  "mark": {
    "type": "bar",
    "color": "#005f73"
  },

  "encoding": {

    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "title": "State"
    },

    "x": {
      "field": "IncidentsPerMillion",
      "type": "quantitative",
      "title": "Shark Incidents per Million Residents"
    },

    "tooltip": [
      {
        "field": "State",
        "type": "nominal"
      },
      {
        "field": "Population",
        "type": "quantitative",
        "title": "Population"
      },
      {
        "field": "Incidents",
        "type": "quantitative",
        "title": "Total Incidents"
      },
      {
        "field": "IncidentsPerMillion",
        "type": "quantitative",
        "format": ".2f",
        "title": "Incidents per Million"
      }
    ]
  }
}
