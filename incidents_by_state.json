{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Incidents by Australian State",

  "width": 700,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "params": [
    {
      "name": "highlight",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "mark": {
    "type": "bar"
  },

  "encoding": {

    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "title": "State"
    },

    "x": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Incidents"
    },

    "color": {
      "condition": {
        "param": "highlight",
        "value": "#d62828"
      },
      "value": "#7aa6c2"
    },

    "opacity": {
      "condition": {
        "param": "highlight",
        "value": 1
      },
      "value": 0.6
    },

    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Number of Incidents"
      }
    ]
  }
}
