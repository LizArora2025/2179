{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "mark": "bar",

  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal"
    },

    "color": {
      "field": "Victim.gender",
      "type": "nominal"
    },

    "y": {
      "aggregate": "count"
    }
  }
}
