{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Fatal vs Injured Shark Incidents by Month",

  "width": 700,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "mark": "bar",

  "encoding": {

    "x": {
      "field": "Incident.month",
      "type": "ordinal",
      "title": "Month"
    },

    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Incidents"
    },

    "color": {
      "field": "Victim.injury",
      "type": "nominal",
      "title": "Outcome",
      "scale": {
        "domain": ["fatal", "injured"],
        "range": ["#d62828", "#5b9bd5"]
      }
    }
  }
}
