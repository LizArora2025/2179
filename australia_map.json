{
  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {
      "type": "csv"
    }
  },

  "params": [
    {
      "name": "hover",
      "select": {
        "type": "point",
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],

  "mark": {
    "type": "circle",
    "opacity": 0.7
  },

  "encoding": {

    "longitude": {
      "field": "Longitude",
      "type": "quantitative"
    },

    "latitude": {
      "field": "Latitude",
      "type": "quantitative"
    },

    "size": {
      "condition": {
        "param": "hover",
        "value": 180
      },
      "value": 70
    },

    "color": {
      "condition": {
        "param": "hover",
        "value": "#8b0000"
      },
      "value": "#d62828"
    },

    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Incident.year",
        "type": "quantitative",
        "title": "Year"
      },
      {
        "field": "Victim.activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "Victim.injury",
        "type": "nominal",
        "title": "Injury"
      }
    ]
  },

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  }
}
