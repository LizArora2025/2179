{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Incidents by Australian State",

  "autosize": {
  "type": "fit",
  "contains": "padding"
},
  
  "width": 650,
  "height": 350,

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {"type": "csv"}
  },

  "mark": "bar",

  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x"
    },

    "x": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Incidents"
    }
  }
}
