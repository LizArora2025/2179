{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Incidents by Month and Time",

  "data": {
    "url": "Australian_Shark_Incidents.csv",
    "format": {"type": "csv"}
  },

  "mark": "rect",

  "encoding": {
    "x": {
      "field": "Incident.month",
      "type": "ordinal",
      "title": "Month"
    },

    "y": {
      "field": "Time.of.incident",
      "type": "ordinal",
      "title": "Time"
    },

    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Incidents"
    }
  }
}